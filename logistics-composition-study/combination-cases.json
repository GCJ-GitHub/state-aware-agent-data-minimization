    "goals": ["pickup_point_changed", "pickup_time_changed"],
    "initial": {"locker_available": true, "desk_available": true},
    "initial_plan": ["identity", "locker", "slot"],
    "before_event": ["identity", "slot"],
    "drift": {"pending": "locker", "fact": "locker_available", "value": false, "new_plan": ["identity", "desk"], "after_recovery": ["desk"]},
    "expected_goals": ["pickup_point_changed", "pickup_time_changed"],
    "expected_fields": ["customer.identity_ref", "parcel.slot_ref", "parcel.desk_ref", "parcel.contact_ref"]

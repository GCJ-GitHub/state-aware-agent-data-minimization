    "initial_plan": ["identity", "locker", "slot"],
    "withhold_fields": ["parcel.contact_ref"],
    "before_event": ["identity", "slot"],
    "drift": {"pending": "locker", "fact": "locker_available", "value": false, "new_plan": [], "after_recovery": []},
